{
  "expo": {
    "name": "Dark Team",
    "slug": "dark-team-fantasy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/team-logo.png",
    "scheme": "darkteamfantasy",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.darkteam.fantasy",
      "infoPlist": {
        "CFBundleDisplayName": "Dark Team",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#07090D",
        "foregroundImage": "./assets/images/team-logo.png"
      },
      "package": "com.darkteam.fantasy"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-router",
      "./plugins/silence-pod-warnings",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/team-logo.png",
          "resizeMode": "cover",
          "backgroundColor": "#07090D"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://script.google.com/macros/s/AKfycbxEDkCTI7tjOiZDR_hgfPgS_r1nmqwMKyutGt5lVD_asuDIACTJH1D-8BknRAOaWSzKUA/exec",
      "leagueKey": "JRJEDMHU"
    }
  }
}
